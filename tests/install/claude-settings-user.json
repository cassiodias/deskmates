{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/deskmates-notify"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-puppet/src/harnesses/claude/translate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/my-stop.sh"
          },
          {
            "type": "command",
            "command": "~/.claude-puppet/src/harnesses/claude/translate.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-puppet/src/harnesses/claude/translate.sh"
          }
        ]
      }
    ]
  }
}
